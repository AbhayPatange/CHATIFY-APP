# Optional. By default the app calls "/api" and "/socket.io" on the same origin
# (Vite proxies them to the backend in dev, the backend serves the build in production).
# Only set these if the API lives on a different origin.
# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com
# Dev proxy target (defaults to http://localhost:3000)
# VITE_DEV_BACKEND=http://localhost:3000
